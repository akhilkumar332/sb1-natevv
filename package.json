{
  "name": "blood-donation-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "install:server-deps": "npm ci --prefix src/functions && npm ci --prefix scripts",
    "postinstall": "npm run install:server-deps",
    "predev": "node scripts/generate-offline-write-inventory.mjs && node scripts/prepare-firebase-config.mjs",
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "build:prod": "node scripts/build.mjs --mode production",
    "seo:generate": "node scripts/generate-seo-artifacts.mjs",
    "offline:inventory": "node scripts/generate-offline-write-inventory.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node src/functions/index.js",
    "dev:server": "nodemon src/functions/index.js",
    "send:fcm": "node scripts/send-fcm-data.mjs",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "memory:baseline": "node scripts/memory-baseline.mjs",
    "memory:check": "node scripts/check-memory-budgets.mjs",
    "deploy": "npm run build:prod && firebase deploy",
    "deploy:hosting": "npm run build:prod && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules,storage:rules",
    "deploy:indexes": "firebase deploy --only firestore:indexes",
    "backfill:version:git": "node scripts/backfill-git-history.mjs",
    "backfill:version:hosting": "node scripts/backfill-firebase-hosting-history.mjs",
    "migrate:bloodbank": "node scripts/migrate-hospital-to-bloodbank.mjs",
    "seed:cms:blog": "node scripts/seed-cms-blog-posts.mjs",
    "sync:cms:blog:summaries": "node scripts/sync-cms-blog-summaries.mjs",
    "migrate:fcm:remove-legacy": "node scripts/migrations/remove-legacy-fcm-keys.mjs",
    "firebase:emulators": "firebase emulators:start",
    "firebase:login": "firebase login",
    "firebase:init": "firebase init"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@tanstack/react-query": "^5.102.3",
    "axios": "^1.19.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "firebase": "^12.18.0",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^15.7.4",
    "react-leaflet": "^4.2.1",
    "react-phone-number-input": "^3.4.18",
    "react-router-dom": "^7.18.2",
    "react-slick": "^0.30.3",
    "slick-carousel": "^1.8.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/fs-extra": "^11.0.4",
    "@types/google.maps": "^3.65.5",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-phone-number-input": "^3.0.17",
    "@types/react-slick": "^0.23.13",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fs-extra": "^11.4.0",
    "globals": "^15.15.0",
    "jsdom": "^27.4.0",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "terser": "^5.50.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "yaml": "^2.8.3",
    "node-forge": "^1.3.2",
    "qs": "^6.14.2",
    "validator": "^13.15.22",
    "serialize-javascript": "^7.0.5",
    "glob@10.4.5": "10.5.0",
    "jws@3.2.2": "3.2.3",
    "jws@4.0.0": "4.0.1"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version",
      "last 1 edge version"
    ]
  }
}
